---
const {
	title = 'Graphics Papers',
	description = 'Essays and experiments in computer graphics.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f4f0e8" />
		<meta name="color-scheme" content="light dark" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<title>{title}</title>
		<script is:inline>
			const savedTheme = localStorage.getItem('theme');
			const theme = savedTheme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			document.documentElement.dataset.theme = theme;
		</script>
	</head>
	<body>
		<button class="theme-toggle" type="button" aria-label="Toggle dark mode">Dark</button>
		<slot />
		<footer class="site-footer">
			<span>Satvik Gupta</span>
			<span><a href="https://github.com/BlacckMangoo">GitHub</a> · <a href="https://blacckmangoo.github.io/myPortfolio/">Portfolio</a> · <a href="https://x.com/satvikk_guptaa">Twitter</a></span>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--paper: #f4f0e8;
		--paper-deep: #e9e2d5;
		--surface: #faf8f3;
		--ink: #211f1b;
		--muted: #69645b;
		--faint: #928b7e;
		--rule: #c9c0b2;
		--rule-dark: #8f877a;
		--accent: #762c32;
		--code-bg: #eee9df;
		--inline-code-bg: rgba(233, 226, 213, 0.65);
		--inline-code-ink: #4e272b;
		--plot-font: #4f4a43;
		--plot-grid: #ddd6ca;
		--plot-zero: #8f877a;
		--serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
		--sans: 'Avenir Next', Avenir, 'Segoe UI', Helvetica, Arial, sans-serif;
		--mono: 'Cascadia Code', 'SFMono-Regular', Consolas, monospace;
		--radius: 2px;
		--border: var(--rule);
		--text: var(--ink);
		--text-muted: var(--muted);
		--accent-strong: var(--accent);
		--surface-strong: var(--surface);
		--shadow: none;
	}

	:root[data-theme='dark'] {
		--paper: #151411;
		--paper-deep: #211f1b;
		--surface: #1b1a17;
		--ink: #eee8dd;
		--muted: #beb6a8;
		--faint: #938b7e;
		--rule: #3e3a33;
		--rule-dark: #71695d;
		--accent: #d59197;
		--code-bg: #1d1c19;
		--inline-code-bg: rgba(75, 68, 58, 0.55);
		--inline-code-ink: #e2adb1;
		--plot-font: #d8d1c5;
		--plot-grid: #3e3a33;
		--plot-zero: #82796d;
		color-scheme: dark;
	}

	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--serif);
		text-rendering: optimizeLegibility;
		transition: background-color 160ms ease, color 160ms ease;
	}
	a { color: inherit; text-decoration: none; }
	a:hover { color: var(--accent); }
	img { display: block; max-width: 100%; }
	code, pre, kbd, samp { font-family: var(--mono); }
	.theme-toggle {
		position: fixed;
		top: 1rem;
		right: 1rem;
		z-index: 10;
		padding: 0.45rem 0.65rem;
		border: 1px solid var(--rule-dark);
		background: var(--paper);
		color: var(--ink);
		font: 650 0.75rem var(--sans);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		cursor: pointer;
	}
	.theme-toggle:hover { color: var(--accent); border-color: var(--accent); }

	.site-header,
	.site-footer {
		width: min(1240px, calc(100% - 3rem));
		margin: 0 auto;
	}
	.site-footer a { text-decoration: underline; text-underline-offset: 0.16em; }

	.site-header {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: 1.3rem 0 0.9rem;
		border-bottom: 3px double var(--rule-dark);
		font-family: var(--sans);
	}

	.site-title { display: flex; align-items: center; }
	.site-title strong { font-size: 1rem; font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; }
	.site-header p { margin: 0; color: var(--muted); font-size: 0.88rem; font-weight: 500; letter-spacing: 0.03em; }
	.site-header nav { justify-self: end; font-size: 0.86rem; font-weight: 650; text-transform: uppercase; letter-spacing: 0.09em; }

	.site-footer {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 0 2.5rem;
		border-top: 1px solid var(--rule-dark);
		color: var(--muted);
		font: 500 0.84rem var(--sans);
		letter-spacing: 0.04em;
	}

	@media (max-width: 720px) {
		.site-header, .site-footer { width: min(100% - 1.5rem, 1240px); }
		.site-header { grid-template-columns: 1fr auto; }
		.site-header p { display: none; }
		.site-footer { flex-direction: column; }
	}
</style>

<script is:inline>
	const button = document.querySelector('.theme-toggle');
	const meta = document.querySelector('meta[name="theme-color"]');
	const syncThemeControl = () => {
		const dark = document.documentElement.dataset.theme === 'dark';
		button.textContent = dark ? 'Light' : 'Dark';
		button.setAttribute('aria-pressed', String(dark));
		meta?.setAttribute('content', dark ? '#151411' : '#f4f0e8');
	};
	button?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
		syncThemeControl();
	});
	syncThemeControl();
</script>
