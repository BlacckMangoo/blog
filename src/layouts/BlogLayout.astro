---
import Layout from './Layout.astro';

interface Heading { depth: number; slug: string; text: string }
interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
	headings?: Heading[];
}

const { title, description, pubDate, updatedDate, tags = [], headings = [] } = Astro.props as Props;
const contents = headings.filter(({ depth }) => depth === 2 || depth === 3);
const date = (value: Date) => new Intl.DateTimeFormat('en', { day: '2-digit', month: 'long', year: 'numeric' }).format(value);
const base = import.meta.env.BASE_URL;
---

<Layout title={`${title} — Graphics Papers`} description={description}>
	<main class="paper-layout">
		<aside class="contents" aria-label="Table of contents">
			<p>Contents</p>
			{contents.length ? (
				<ol>
					{contents.map((heading) => <li class:list={[heading.depth === 3 && 'subsection']}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
				</ol>
			) : <span>Short paper</span>}
		</aside>

		<article class="article-shell">
			<header class="article-header">
				<a class="back-link" href={base}>Journal index</a>
				<p class="article-kind">Technical essay</p>
				<h1>{title}</h1>
				<div class="byline">
					<span>Satvik Gupta</span>
					<span>Published {date(pubDate)}</span>
					{updatedDate && <span>Revised {date(updatedDate)}</span>}
				</div>
				<section class="abstract" aria-label="Abstract">
					<strong>Abstract</strong>
					<p>{description}</p>
				</section>
				{tags.length > 0 && <p class="keywords"><strong>Keywords:</strong> {tags.join(', ')}</p>}
			</header>
			<div class="prose article-body"><slot /></div>
		</article>
	</main>
</Layout>

<style>
	.paper-layout {
		display: grid;
		grid-template-columns: minmax(150px, 220px) minmax(0, 760px) minmax(40px, 1fr);
		gap: clamp(2rem, 5vw, 5rem);
		width: min(1240px, calc(100% - 3rem));
		margin: 0 auto;
		padding: 4.5rem 0 6rem;
	}
	.article-shell { min-width: 0; }
	.contents { position: sticky; top: 2rem; align-self: start; font-family: var(--sans); font-size: 0.84rem; font-weight: 500; line-height: 1.5; }
	.contents > p { margin: 0 0 0.8rem; padding-bottom: 0.45rem; border-bottom: 1px solid var(--rule-dark); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
	.contents ol { margin: 0; padding: 0; list-style: none; counter-reset: toc; }
	.contents li { counter-increment: toc; display: grid; grid-template-columns: 1.6rem 1fr; margin: 0.55rem 0; color: var(--muted); }
	.contents li::before { content: counter(toc, decimal-leading-zero); color: var(--faint); font-variant-numeric: tabular-nums; }
	.contents .subsection { padding-left: 1rem; font-size: 0.78rem; }
	.contents > span { color: var(--faint); font-style: italic; }
	.back-link, .article-kind, .byline, .keywords { font-family: var(--sans); }
	.back-link { display: inline-block; margin-bottom: 2.5rem; color: var(--accent); font-size: 0.82rem; font-weight: 650; letter-spacing: 0.09em; text-transform: uppercase; }
	.back-link::before { content: '← '; }
	.article-kind { margin: 0 0 0.9rem; color: var(--muted); font-size: 0.8rem; font-weight: 650; letter-spacing: 0.14em; text-transform: uppercase; }
	h1 { max-width: 18ch; margin: 0; font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.025em; }
	.byline { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: 1.4rem; padding: 0.75rem 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); color: var(--muted); font-size: 0.82rem; font-weight: 500; }
	.byline span:first-child { color: var(--ink); font-weight: 650; }
	.abstract { margin-top: 2.2rem; font-size: 1.04rem; line-height: 1.7; }
	.abstract strong { float: left; margin: 0.15rem 1rem 0 0; font: 750 0.82rem var(--sans); letter-spacing: 0.11em; text-transform: uppercase; }
	.abstract p { margin: 0; }
	.keywords { margin: 1rem 0 3.5rem; color: var(--muted); font-size: 0.84rem; font-weight: 500; }
	.keywords strong { color: var(--ink); }
	@media (max-width: 980px) {
		.paper-layout { grid-template-columns: minmax(0, 760px); justify-content: center; }
		.contents { position: static; order: 2; display: none; }
	}
	@media (max-width: 720px) {
		.paper-layout { width: min(100% - 1.5rem, 760px); padding: 2.5rem 0 4rem; }
		h1 { font-size: clamp(2.35rem, 12vw, 3.5rem); }
		.abstract strong { float: none; display: block; margin-bottom: 0.5rem; }
	}
</style>
