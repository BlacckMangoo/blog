---
const { cite } = Astro.props;
---

<blockquote class="quote">
	<div class="quote__mark">“</div>
	<div class="quote__body"><slot /></div>
	{cite && <footer class="quote__cite">— {cite}</footer>}
</blockquote>

<style>
	.quote { margin: 2rem 0 2rem 2rem; padding: 0.2rem 0 0.2rem 1.3rem; border-left: 2px solid var(--accent); background: transparent; }
	.quote__mark { height: 1.2rem; color: var(--accent); font-size: 2.2rem; line-height: 1; }
	.quote__body :global(p) { margin: 0.4rem 0 0; font-size: 1.05rem; line-height: 1.7; }
	.quote__cite { margin-top: 0.7rem; color: var(--muted); font: 0.75rem var(--sans); font-style: normal; }
	@media (max-width: 640px) { .quote { margin-left: 0; } }
</style>
