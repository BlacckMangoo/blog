---
import { Image } from 'astro:assets';

const { src, caption, alt = '' } = Astro.props;
---

<figure class="figure">
	<Image src={src} alt={alt} class="figure__image" loading="lazy" />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.figure {
		margin: 1.75rem 0;
	}

	.figure__image {
		width: 100%;
		height: auto;
		border: 1px solid var(--rule);
	}

	figcaption {
		margin-top: 0.75rem;
		font-size: 0.82rem;
		line-height: 1.6;
		color: var(--muted);
	}
</style>
